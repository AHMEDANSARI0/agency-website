# ==============================================================================
# OmniFlow Environment Configuration (Safe Placeholders Only - NEVER commit .env)
# Copy to .env for local development or configure in Vercel Environment Variables.
# ==============================================================================

# 1. Canonical Public Site URL (update to https://yourdomain.com in production)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# 2. Cryptographic Session Secret (MANDATORY in production: min 32 random chars)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-at-least-32-random-hex-characters-in-production"
SESSION_TTL_HOURS="24"

# 3. Database — Supabase PostgreSQL (MANDATORY in production)
# Leave empty ONLY in local development (`npm run dev`) to use data/omniflow-db.json.
# Production NEVER falls back to local JSON. Use Supabase Transaction Pooler (:6543):
# postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=""

# 4. Initial Super Admin Setup & Bootstrap Security
# Option A (Recommended): Leave ADMIN_BOOTSTRAP_PASSWORD empty in production and complete
# one-time setup at /admin/setup using ADMIN_SETUP_TOKEN.
# Option B: Provide a strong unique ADMIN_BOOTSTRAP_EMAIL + ADMIN_BOOTSTRAP_PASSWORD (10+ chars,
# upper/lower/number; known defaults are rejected). First login forces password replacement.
ADMIN_BOOTSTRAP_NAME="Ahmed Ansari"
ADMIN_BOOTSTRAP_EMAIL=""
ADMIN_BOOTSTRAP_PASSWORD=""
ADMIN_SETUP_TOKEN="replace-with-random-one-time-setup-token"
ADMIN_FORCE_FIRST_PASSWORD_CHANGE="true"

# 5. Persistent Media Storage — Supabase Storage (MANDATORY in production)
# Create a public bucket named `omniflow-media` in Supabase Storage.
# Keep SUPABASE_SERVICE_ROLE_KEY strictly server-side (never prefix with NEXT_PUBLIC_).
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="omniflow-media"
MEDIA_MAX_FILE_BYTES="4194304"
MEDIA_TOTAL_QUOTA_BYTES="524288000"

# 6. Transactional Email & Recovery Alerts — Resend Free Tier (Optional)
# Leads are always saved in PostgreSQL first even if email is unconfigured.
RESEND_API_KEY=""
NOTIFICATION_FROM_EMAIL="OmniFlow <notifications@yourdomain.com>"
NOTIFICATION_TO_EMAIL="hello@yourdomain.com"

# 7. Privacy-Aware Analytics (Optional — loads ONLY after visitor cookie consent)
NEXT_PUBLIC_GA4_MEASUREMENT_ID=""

# 8. Production Security Headers (Set to "true" on custom HTTPS production domain)
ENABLE_STRICT_FRAME_HEADERS="false"
