# ==============================================================================
# OmniFlow Environment Configuration (Safe Placeholders Only - NEVER commit .env)
# ==============================================================================

# Public Site Canonical Base URL (update when custom domain is attached on Vercel)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NODE_ENV="development"

# Authentication & Session Security (REQUIRED in production: min 32 random chars)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-at-least-32-random-hex-characters-in-production"
SESSION_TTL_HOURS="24"

# Initial Super Admin Bootstrap Credentials (used only on first seed/bootstrap)
ADMIN_BOOTSTRAP_EMAIL="admin@omniflow.example"
ADMIN_BOOTSTRAP_PASSWORD="ChangeMe_StrongPass_2026!"
ADMIN_BOOTSTRAP_NAME="Ahmed Ansari"

# Database (Supabase PostgreSQL Free Tier for Vercel Production)
# Leave empty in local development to use automatic local JSON database fallback.
# Example Supabase Transaction Pooler URL:
# postgresql://postgres.[project-ref]:[password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=""

# Media Storage (Supabase Storage Free Tier - 1 GB quota)
# Leave empty in local development to use local public/uploads fallback.
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="omniflow-media"

# Optional Free Email Notification Integration (Resend Free Tier - 3,000/mo)
# Leave empty to store all leads safely in CRM without external email dependency.
RESEND_API_KEY=""
NOTIFICATION_FROM_EMAIL="OmniFlow <notifications@omniflow.example>"
NOTIFICATION_TO_EMAIL="hello@omniflow.example"

# Optional Privacy-Aware Analytics (loaded ONLY after user cookie consent)
NEXT_PUBLIC_GA4_MEASUREMENT_ID=""

# Optional Production Security Hardening (enable on standalone production domain)
ENABLE_STRICT_FRAME_HEADERS="false"
