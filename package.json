{
  "name": "omniflow-platform",
  "version": "1.0.0",
  "private": true,
  "description": "OmniFlow — AI Automation & Business Solutions Website & Administration Platform",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node scripts/clean-dev-cache.mjs && next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "preflight": "node scripts/preflight-check.mjs",
    "analyze": "ANALYZE=true next build",
    "perf:audit": "node scripts/lighthouse-ci.mjs",
    "verify": "npm run preflight && npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "lenis": "^1.3.27",
    "lucide-react": "1.77.0",
    "next": "15.5.29",
    "postgres": "3.4.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "web-vitals": "^6.2.3",
    "zod": "3.24.4"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.4.6",
    "@types/node": "^20.19.0",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.29",
    "postcss": "8.5.3",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
